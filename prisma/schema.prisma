// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TimeBlockType {
  TASK
  ROUTINE
  BREAK
  MEETING
  BUFFER
  PERSONAL
}

enum RoutineFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}
//////////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////////

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  vision    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories   Category[]
  task         Task[]
  timeBlocks   TimeBlock[]
  routines     Routine[]
  availability Availability[]
  aiContexts   AIContext[]
  settings     Settings?
}

//////////////////////////////////////////////////////
// Category
//////////////////////////////////////////////////////

model Category {
  id String @id @default(cuid())

  name String

  weeklyTargetHours Float

  color String?

  icon String?

  isActive Boolean @default(true)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  goals Goal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


//////////////////////////////////////////////////////
// GOALS
//////////////////////////////////////////////////////

model Goal {

  id String @id @default(cuid())

  title String
  description String?

  priority GoalPriority @default(MEDIUM)

  deadline DateTime?

  status GoalStatus @default(NOT_STARTED)

  isActive Boolean @default(true)

  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TASKS (PLANNING LAYER)
//////////////////////////////////////////////////////

model Task {
  id          String   @id @default(cuid())

  title       String
  description String?

  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus @default(PENDING)

  estimatedMinutes Int
  completedMinutes Int @default(0)

  order Int?

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId String?
  goal   Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  timeBlocks TimeBlock[]
  sessions   TaskSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// ROUTINES (REAL LIFE CONSTRAINTS)
//////////////////////////////////////////////////////

model Routine {
  id          String   @id @default(cuid())

  title       String
  description String?

  frequency   RoutineFrequency

  // e.g. "Monday", "Tuesday"
  dayOfWeek   Int?

  startTime   String
  endTime     String

  isActive    Boolean @default(true)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TIME BLOCKS (EXECUTION LAYER)
//////////////////////////////////////////////////////

model TimeBlock {
  id String @id @default(cuid())

  date DateTime

  startTime DateTime
  endTime   DateTime

  type TimeBlockType

  title String

  completed Boolean @default(false)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// TASK EXECUTION TRACKING
//////////////////////////////////////////////////////

model TaskSession {
  id String @id @default(cuid())

  taskId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  startedAt DateTime
  endedAt   DateTime?

  duration Int?
  wasPaused Boolean @default(false)

  createdAt DateTime @default(now())
}

//////////////////////////////////////////////////////
// WEEKLY AVAILABILITY
//////////////////////////////////////////////////////

model Availability {
  id String @id @default(cuid())

  dayOfWeek Int

  startTime String
  endTime   String

  isAvailable Boolean @default(true)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////
// SETTINGS
//////////////////////////////////////////////////////

model Settings {
  id String @id @default(cuid())


  workHoursPerDay     Int @default(8)
  breakMinutes        Int @default(15)
  focusSessionMinutes Int @default(60)

  theme String?

  userId String @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////
// AI MEMORY
//////////////////////////////////////////////////////

model AIContext {
  id String @id @default(cuid())

  key   String
  value Json

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}